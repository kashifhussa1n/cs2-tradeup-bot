# CSFloat profile -> developer tab. Never commit credentials.
CSFLOAT_API_KEY=
# Optional Discord results/status webhook.
DISCORD_WEBHOOK_URL=
# For docker compose up / unattended runs. Leave commented for interactive prompt.
# BUDGET_OVERRIDE=20
SELL_FEE_PERCENT=13
MIN_PROFIT_DOLLARS=0.10
MIN_ROI_PERCENT=1
# upside allows negative EV when profitable outcomes meet these thresholds.
# expected_value restores the original strict positive-EV filter.
SEARCH_MODE=upside
MIN_WIN_CHANCE_PERCENT=20
MIN_WIN_PROFIT_DOLLARS=0.10
MAX_CSFLOAT_REQUESTS_PER_RUN=30
CSFLOAT_REQUEST_DELAY=3
LIVE_TTL=120
USE_SKINPORT_SNAPSHOT=1
DISCOVERY_TTL=86400
DISCOVERY_MAX_AGE=604800
LOCAL_SHORTLIST=40
LIVE_SHORTLIST=12
BLOCKS_PER_COLLECTION=6
PAIR_POOL_SIZE=100
FLOAT_SCENARIOS=5
DISCOVERY_PRICE_TOLERANCE=0.15
OPTIMIZER_WIDTH=64
MAX_RESULTS_TO_SHOW=5
SCORE_ROI_WEIGHT=0.01
SCORE_RISK_WEIGHT=0.15
DATA_DIR=data
AUTO_RESUME=1
AUTO_RESUME_DELAY_SECONDS=300
AUTO_MAX_BATCHES=10
